# syntax=docker/dockerfile:1
# ------------------------------------------------------------------------------
# ChatSphere Frontend Dockerfile (Vite Build + Nginx Alpine Server)
# ------------------------------------------------------------------------------

# Stage 1: Build Frontend Assets
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package specifications for caching
COPY package.json package-lock.json* bun.lock* ./

# Install dependencies needed for build
RUN npm install --legacy-peer-deps

# Copy frontend source files
COPY tsconfig.json vite.config.ts index.html metadata.json ./
COPY src/ ./src/

# Compile production Vite distribution
RUN npm run build

# Stage 2: High-Performance Nginx Web Server
FROM nginx:1.27-alpine AS runner

# Copy compiled static assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration with reverse proxy and caching
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose standard HTTP port
EXPOSE 80

# Container healthcheck
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/healthz || exit 1

# Start Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
